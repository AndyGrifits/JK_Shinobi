repeatDelay				0

// Great fireball in flight: the ball itself is drawn by the cgame; this only
// sheds a short trail of embers and wisps of smoke behind it (local X = travel
// direction, so negative X velocity = backwards).

Particle
{
	name				embers
	count				2 3
	life				250 450
	spawnFlags			orgOnSphere axisFromSphere
	radius				6 12
	vel					20 0 0 60 0 0
	gravity				-80
	size
	{
		start			1.5 3
		end				0
	}
	rgb
	{
		start			1 0.65 0.2
	}
	shaders
	[
		gfx/shinobi/spark
	]
}

Particle
{
	name				flicker
	count				1
	life				90 130
	rotation			0 360
	spawnFlags			orgOnSphere
	radius				4 10
	vel					-80 -15 -15 -40 15 15
	size
	{
		start			10 14
		end				4
	}
	rgb
	{
		start			1 0.5 0.12
		end				0.7 0.15 0.02
	}
	shaders
	[
		gfx/shinobi/fire
	]
}

Particle
{
	name				smoke
	flags				useAlpha
	count				0 1
	life				500 800
	rotation			0 360
	vel					-50 -10 10 -20 10 30
	size
	{
		start			8 12
		end				24 32
	}
	rgb
	{
		start			0.22 0.2 0.18
	}
	alpha
	{
		start			0.35
		end				0
	}
	shaders
	[
		gfx/shinobi/smoke
	]
}
