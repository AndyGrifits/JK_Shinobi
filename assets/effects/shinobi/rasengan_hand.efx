repeatDelay				0

// Held Rasengan: the ball itself is drawn every frame by the cgame (layered
// sprites); this effect, played every ~60ms, adds loose chakra sparks and
// wisps spinning off it.

Particle
{
	name				sparks
	count				1 3
	life				150 300
	spawnFlags			orgOnSphere axisFromSphere
	radius				5 9
	vel					40 -80 -80 120 80 80
	size
	{
		start			1.2 2.2
		end				0
	}
	rgb
	{
		start			0.7 0.9 1
	}
	shaders
	[
		gfx/shinobi/spark
	]
}

Particle
{
	name				wisps
	count				0 1
	life				120 200
	rotation			0 360
	rotationDelta		100 160
	spawnFlags			orgOnSphere
	radius				2 5
	size
	{
		start			6 9
		end				14 18
	}
	rgb
	{
		start			0.3 0.6 1
	}
	alpha
	{
		start			0.7
		end				0
	}
	shaders
	[
		gfx/shinobi/swirl
	]
}
