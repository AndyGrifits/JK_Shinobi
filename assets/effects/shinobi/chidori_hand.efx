repeatDelay				0

// Held Chidori: the crackling ball is drawn every frame by the cgame; this
// effect (every ~60ms) throws arcs and sparks off it in every direction.

Particle
{
	name				arcs
	count				2 3
	life				50 90
	rotation			0 360
	spawnFlags			orgOnSphere axisFromSphere
	radius				6 12
	vel					40 0 0 120 0 0
	size
	{
		start			10 20
	}
	rgb
	{
		start			0.55 0.75 1 0.9 0.95 1
	}
	alpha
	{
		start			1
		end				0.2
	}
	shaders
	[
		gfx/shinobi/bolt
	]
}

Particle
{
	name				sparks
	count				2 4
	life				120 250
	spawnFlags			orgOnSphere axisFromSphere
	radius				4 8
	vel					120 0 0 260 0 0
	gravity				-250
	size
	{
		start			1 2.2
		end				0
	}
	rgb
	{
		start			0.8 0.9 1
	}
	shaders
	[
		gfx/shinobi/spark
	]
}

Particle
{
	name				ground
	count				0 1
	life				60 100
	rotation			0 360
	spawnFlags			orgOnSphere
	radius				14 26
	size
	{
		start			8 14
	}
	rgb
	{
		start			0.5 0.7 1
	}
	shaders
	[
		gfx/shinobi/bolt
	]
}
