// JK_Shinobi shadow clone (Kage Bunshin).
// Model, skin, saber, health, teams and leader are overridden in code
// (g_shinobi.c) to copy the player who cast the jutsu.

shinobi_clone
{
	playerModel	kyle
	customSkin	default
	weapon		WP_SABER
	saber		shinobi_katana
	saberColor	blue
	saberStyle	2
	class		CLASS_JEDI
	rank		lt
	health		1
	reactions	4
	aim			5
	move		5
	aggression	4
	evasion		3
	intelligence	5
	hfov		120
	vfov		120
	visrange	1500
	earshot		1024
	vigilance	0.8
	walkSpeed	55
	runSpeed	230
	yawSpeed	140
	FP_LEVITATION	2
	FP_SPEED	1
	FP_PUSH		1
	FP_SABER_OFFENSE	2
	FP_SABER_DEFENSE	1
	FP_SABERTHROW	1
	forcePowerMax	100
	dismemberProbHead	0
	dismemberProbArms	0
	dismemberProbHands	0
	dismemberProbWaist	0
	dismemberProbLegs	0
}

// Sound ninja (Oto) of the procedural Orochimaru maze (codemp/game/g_shinobi_maze.c spawns them into the
// layout's NPC slots and drives patrol / guard / ambush, spotting and alerts on top of the stock reborn AI).
oto_ninja
{
	playerModel	reborn
	customSkin	default
	weapon		WP_SABER
	saber		shinobi_kurosawa
	saberStyle	1
	class		CLASS_REBORN
	rank		crewman
	playerTeam	NPCTEAM_ENEMY
	enemyTeam	NPCTEAM_PLAYER
	health		80
	reactions	3
	aim			3
	move		4
	aggression	3
	evasion		2
	intelligence	3
	hfov		140
	vfov		100
	visrange	1400
	earshot		700
	vigilance	0.6
	walkSpeed	60
	runSpeed	220
	yawSpeed	110
	FP_LEVITATION	2
	FP_SABER_OFFENSE	1
	FP_SABER_DEFENSE	1
	forcePowerMax	100
	dismemberProbHead	0
	dismemberProbArms	0
	dismemberProbHands	0
	dismemberProbWaist	0
	dismemberProbLegs	0
}

